{
  "expo": {
    "name": "zappr",
    "slug": "zappr",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "zappr",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "xyz.usezappr.app",
      "associatedDomains": [
        "webcredentials:usezappr.xyz"
      ],
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSFaceIDUsageDescription": "zappr uses Face ID to unlock your keys and wallet."
      }
    },
    "android": {
      "package": "xyz.usezappr.app",
      "adaptiveIcon": {
        "backgroundColor": "#F1EFE7",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "zappr uses Face ID to unlock your keys and wallet."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F1EFE7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "55268c87-d019-4cdb-95f5-18b6023ca8ef"
      }
    },
    "owner": "miracle_codes"
  }
}
