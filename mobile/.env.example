# Copy to mobile/.env — values prefixed EXPO_PUBLIC_ are inlined into the
# app bundle at build time (they are PUBLIC, never put server secrets here).

# Breez API key — Breez ships this client-side by design (same as the web
# app's NEXT_PUBLIC_BREEZ_API_KEY). Required only for the seedless
# self-custodial wallet path, which on native needs an EAS dev build and
# the #6 passkey spike; harmless to set now, unused until then.
EXPO_PUBLIC_BREEZ_API_KEY=

# Deployed zappr web app that serves /api/agent and /api/offramp/*.
EXPO_PUBLIC_ZAPPR_API_BASE=https://www.usezappr.xyz

# Comma-separated Nostr relay list (defaults to the same five as web).
EXPO_PUBLIC_DEFAULT_RELAYS=
