ANTHROPIC_API_KEY=sk-ant-...
# Get a free Breez API key at https://breez.technology/request-api-key/
# Required only for the seedless "Start fresh" passkey wallet path.
# Existing nsec / NIP-07 / NWC paths work without it.
NEXT_PUBLIC_BREEZ_API_KEY=
NEXT_PUBLIC_APP_NAME=zappr
NEXT_PUBLIC_DEFAULT_RELAYS=wss://relay.damus.io,wss://relay.nostr.band,wss://nos.lol,wss://relay.primal.net,wss://relay.yakihonne.com

# MavaPay — Lightning ↔ NGN bank offramp. Server-side only (never NEXT_PUBLIC_).
# Request a key at https://mavapay.co/. Use staging while testing — auto-pays
# Lightning invoices for free.
MAVAPAY_BASE_URL=https://staging.api.mavapay.co/api/v1
MAVAPAY_API_KEY=
MAVAPAY_WEBHOOK_SECRET=

NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# WebAuthn RP ID for passkeys (issue #12). Set to the REGISTRABLE domain in
# production (usezappr.xyz) so one passkey works on both apex and www — and on
# the mobile app. Leave empty on localhost / *.vercel.app previews (falls back
# to the hostname; a vercel.app suffix is rejected by WebAuthn).
# One-way door: changing this orphans passkeys enrolled under the old value.
NEXT_PUBLIC_RP_ID=

# OpenAI fallback for the agent (optional). Server-side only — never
# NEXT_PUBLIC_. When the Claude call fails (rate limit, overload, exhausted
# credits), /api/agent transparently re-runs the request on OpenAI; both web
# and mobile clients are unaffected. OPENAI_MODEL defaults to gpt-4o-mini.
OPENAI_API_KEY=
OPENAI_MODEL=
